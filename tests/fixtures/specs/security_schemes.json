{
  "openapi": "3.0.3",
  "info": {
    "title": "Security Schemes Test API",
    "version": "1.0.0",
    "description": "Comprehensive specification covering Bearer, Basic, API Key (Header & Query), OAuth2 with scopes, optional security, and compound security."
  },
  "paths": {
    "/bearer-endpoint": {
      "get": {
        "operationId": "getBearerResource",
        "summary": "Endpoint protected by Bearer token",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token_type": {"type": "string"}
                  },
                  "required": ["token_type"]
                }
              }
            }
          }
        }
      }
    },
    "/basic-endpoint": {
      "get": {
        "operationId": "getBasicResource",
        "summary": "Endpoint protected by HTTP Basic auth",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "authenticated": {"type": "boolean"}
                  },
                  "required": ["authenticated"]
                }
              }
            }
          }
        }
      }
    },
    "/api-key-header-endpoint": {
      "post": {
        "operationId": "postApiKeyHeaderResource",
        "summary": "Endpoint protected by API key in header",
        "security": [
          {
            "apiKeyHeaderAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {"type": "string"}
                  },
                  "required": ["status"]
                }
              }
            }
          }
        }
      }
    },
    "/api-key-query-endpoint": {
      "get": {
        "operationId": "getApiKeyQueryResource",
        "summary": "Endpoint protected by API key in query parameter",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "security": [
          {
            "apiKeyQueryAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {"type": "array", "items": {"type": "string"}}
                  },
                  "required": ["items"]
                }
              }
            }
          }
        }
      }
    },
    "/oauth2-endpoint": {
      "get": {
        "operationId": "getOAuth2Resource",
        "summary": "Endpoint protected by OAuth2 with scopes",
        "security": [
          {
            "oauth2Auth": ["read:pets", "write:pets"]
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "scopes_granted": {"type": "array", "items": {"type": "string"}}
                  },
                  "required": ["scopes_granted"]
                }
              }
            }
          }
        }
      }
    },
    "/optional-security-endpoint": {
      "get": {
        "operationId": "getOptionalSecurityResource",
        "summary": "Endpoint with optional security",
        "security": [
          {
            "bearerAuth": []
          },
          {}
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "is_public": {"type": "boolean"}
                  },
                  "required": ["is_public"]
                }
              }
            }
          }
        }
      }
    },
    "/multi-alternative-endpoint": {
      "get": {
        "operationId": "getMultiAlternativeResource",
        "summary": "Endpoint with multiple alternative security schemes",
        "security": [
          {
            "apiKeyHeaderAuth": []
          },
          {
            "bearerAuth": []
          },
          {
            "basicAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "auth_method": {"type": "string"}
                  },
                  "required": ["auth_method"]
                }
              }
            }
          }
        }
      }
    },
    "/compound-security-endpoint": {
      "post": {
        "operationId": "postCompoundSecurityResource",
        "summary": "Endpoint requiring both API key and App ID",
        "security": [
          {
            "apiKeyHeaderAuth": [],
            "appIdAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "compound_verified": {"type": "boolean"}
                  },
                  "required": ["compound_verified"]
                }
              }
            }
          }
        }
      }
    },
    "/public-endpoint": {
      "get": {
        "operationId": "getPublicResource",
        "summary": "Public endpoint with no security",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "public_data": {"type": "string"}
                  },
                  "required": ["public_data"]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Standard JWT Bearer token"
      },
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Standard HTTP Basic authentication"
      },
      "apiKeyHeaderAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key passed in custom header"
      },
      "apiKeyQueryAuth": {
        "type": "apiKey",
        "in": "query",
        "name": "api_key",
        "description": "API key passed in query parameter"
      },
      "appIdAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-App-Id",
        "description": "Application identifier header"
      },
      "oauth2Auth": {
        "type": "oauth2",
        "description": "OAuth2 authentication with authorization code flow",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "tokenUrl": "https://example.com/oauth/token",
            "scopes": {
              "read:pets": "Read pet records",
              "write:pets": "Create and update pet records"
            }
          }
        }
      }
    }
  }
}

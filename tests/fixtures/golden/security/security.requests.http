@baseUrl = http://localhost:8000
@apiKeyHeaderAuth = <api_key>
@apiKeyQueryAuth = <api_key>
@appIdAuth = <api_key>
@basicAuth = <credentials>
@bearerAuth = <token>
@oauth2Auth = <token>

###
# @name getBearerResource
# Operation: getBearerResource
# Description: Verify Bearer token protected endpoint
# Expected Status: 200
# Expected Schema: object (properties: token_type)
# Security: bearerAuth
GET {{baseUrl}}/bearer-endpoint HTTP/1.1
Accept: application/json
Authorization: Bearer {{bearerAuth}}

###
# @name getBearerResource_401
# Operation: getBearerResource
# Description: [401] Missing authentication credentials - getBearerResource
# Expected Status: 401
GET {{baseUrl}}/bearer-endpoint HTTP/1.1
Accept: application/json

###
# @name getBearerResource_403
# Operation: getBearerResource
# Description: [403] Invalid authentication credentials - getBearerResource
# Expected Status: 403
GET {{baseUrl}}/bearer-endpoint HTTP/1.1
Accept: application/json
Authorization: Bearer invalid_token

###
# @name getBasicResource
# Operation: getBasicResource
# Description: Verify HTTP Basic protected endpoint
# Expected Status: 200
# Expected Schema: object (properties: authenticated)
# Security: basicAuth
GET {{baseUrl}}/basic-endpoint HTTP/1.1
Accept: application/json
Authorization: Basic {{basicAuth}}

###
# @name getBasicResource_401
# Operation: getBasicResource
# Description: [401] Missing authentication credentials - getBasicResource
# Expected Status: 401
GET {{baseUrl}}/basic-endpoint HTTP/1.1
Accept: application/json

###
# @name getBasicResource_403
# Operation: getBasicResource
# Description: [403] Invalid authentication credentials - getBasicResource
# Expected Status: 403
GET {{baseUrl}}/basic-endpoint HTTP/1.1
Accept: application/json
Authorization: Basic aW52YWxpZDppbnZhbGlk

###
# @name postApiKeyHeaderResource
# Operation: postApiKeyHeaderResource
# Description: Verify API key header protected endpoint
# Expected Status: 201
# Expected Schema: object (properties: status)
# Security: apiKeyHeaderAuth
POST {{baseUrl}}/api-key-header-endpoint HTTP/1.1
Content-Type: application/json
X-API-Key: {{apiKeyHeaderAuth}}

{
  "action": "test"
}

###
# @name postApiKeyHeaderResource_401
# Operation: postApiKeyHeaderResource
# Description: [401] Missing authentication credentials - postApiKeyHeaderResource
# Expected Status: 401
POST {{baseUrl}}/api-key-header-endpoint HTTP/1.1
Content-Type: application/json

{
  "action": "test"
}

###
# @name postApiKeyHeaderResource_403
# Operation: postApiKeyHeaderResource
# Description: [403] Invalid authentication credentials - postApiKeyHeaderResource
# Expected Status: 403
POST {{baseUrl}}/api-key-header-endpoint HTTP/1.1
Content-Type: application/json
X-API-Key: invalid_x_api_key

{
  "action": "test"
}

###
# @name getApiKeyQueryResource
# Operation: getApiKeyQueryResource
# Description: Verify API key query parameter protected endpoint
# Expected Status: 200
# Expected Schema: object (properties: items)
# Security: apiKeyQueryAuth
GET {{baseUrl}}/api-key-query-endpoint?limit=10&api_key={{apiKeyQueryAuth}} HTTP/1.1
Accept: application/json

###
# @name getApiKeyQueryResource_401
# Operation: getApiKeyQueryResource
# Description: [401] Missing authentication credentials - getApiKeyQueryResource
# Expected Status: 401
GET {{baseUrl}}/api-key-query-endpoint?limit=10 HTTP/1.1
Accept: application/json

###
# @name getApiKeyQueryResource_403
# Operation: getApiKeyQueryResource
# Description: [403] Invalid authentication credentials - getApiKeyQueryResource
# Expected Status: 403
GET {{baseUrl}}/api-key-query-endpoint?limit=10&api_key=invalid_api_key HTTP/1.1
Accept: application/json

###
# @name getOAuth2Resource
# Operation: getOAuth2Resource
# Description: Verify OAuth2 with scopes protected endpoint
# Expected Status: 200
# Expected Schema: object (properties: scopes_granted)
# Security: oauth2Auth
# Scopes: read:pets, write:pets
GET {{baseUrl}}/oauth2-endpoint HTTP/1.1
Accept: application/json
Authorization: Bearer {{oauth2Auth}}

###
# @name getOAuth2Resource_401
# Operation: getOAuth2Resource
# Description: [401] Missing authentication credentials - getOAuth2Resource
# Expected Status: 401
GET {{baseUrl}}/oauth2-endpoint HTTP/1.1
Accept: application/json

###
# @name getOAuth2Resource_403
# Operation: getOAuth2Resource
# Description: [403] Invalid authentication credentials - getOAuth2Resource
# Expected Status: 403
GET {{baseUrl}}/oauth2-endpoint HTTP/1.1
Accept: application/json
Authorization: Bearer invalid_token

###
# @name getOptionalSecurityResource
# Operation: getOptionalSecurityResource
# Description: Verify optional security endpoint
# Expected Status: 200
# Expected Schema: object (properties: is_public)
# Security: bearerAuth (optional)
GET {{baseUrl}}/optional-security-endpoint HTTP/1.1
Accept: application/json
Authorization: Bearer {{bearerAuth}}

###
# @name getMultiAlternativeResource
# Operation: getMultiAlternativeResource
# Description: Verify multi-alternative security endpoint
# Expected Status: 200
# Expected Schema: object (properties: auth_method)
# Security: bearerAuth
# Alternatives: apiKeyHeaderAuth, basicAuth
GET {{baseUrl}}/multi-alternative-endpoint HTTP/1.1
Accept: application/json
Authorization: Bearer {{bearerAuth}}

###
# @name getMultiAlternativeResource_401
# Operation: getMultiAlternativeResource
# Description: [401] Missing authentication credentials - getMultiAlternativeResource
# Expected Status: 401
GET {{baseUrl}}/multi-alternative-endpoint HTTP/1.1
Accept: application/json

###
# @name getMultiAlternativeResource_403
# Operation: getMultiAlternativeResource
# Description: [403] Invalid authentication credentials - getMultiAlternativeResource
# Expected Status: 403
GET {{baseUrl}}/multi-alternative-endpoint HTTP/1.1
Accept: application/json
Authorization: Bearer invalid_token

###
# @name postCompoundSecurityResource
# Operation: postCompoundSecurityResource
# Description: Verify compound security endpoint
# Expected Status: 200
# Expected Schema: object (properties: compound_verified)
# Security: apiKeyHeaderAuth
# Security: appIdAuth
POST {{baseUrl}}/compound-security-endpoint HTTP/1.1
Content-Type: application/json
X-API-Key: {{apiKeyHeaderAuth}}
X-App-Id: {{appIdAuth}}

{
  "ping": "pong"
}

###
# @name postCompoundSecurityResource_401
# Operation: postCompoundSecurityResource
# Description: [401] Missing authentication credentials - postCompoundSecurityResource
# Expected Status: 401
POST {{baseUrl}}/compound-security-endpoint HTTP/1.1
Content-Type: application/json

{
  "ping": "pong"
}

###
# @name postCompoundSecurityResource_403
# Operation: postCompoundSecurityResource
# Description: [403] Invalid authentication credentials - postCompoundSecurityResource
# Expected Status: 403
POST {{baseUrl}}/compound-security-endpoint HTTP/1.1
Content-Type: application/json
X-API-Key: invalid_x_api_key
X-App-Id: <api_key>

{
  "ping": "pong"
}

###
# @name getPublicResource
# Operation: getPublicResource
# Description: Verify public endpoint
# Expected Status: 200
# Expected Schema: object (properties: public_data)
GET {{baseUrl}}/public-endpoint HTTP/1.1
Accept: application/json

@baseUrl = http://localhost:8000

###
# @name listPets
# Operation: listPets
# Description: List all pets with optional limit filter
# Expected Status: 200
# Expected Properties: id, name, tag
GET {{baseUrl}}/pets?limit=10 HTTP/1.1
Accept: application/json

###
# @name createPets
# Operation: createPets
# Description: Create a new pet in store
# Expected Status: 201
# Expected Properties: id, name, tag
POST {{baseUrl}}/pets HTTP/1.1
Accept: application/json
Content-Type: application/json

{
  "name": "Fido",
  "tag": "dog"
}

###
# @name showPetById
# Operation: showPetById
# Description: Retrieve specific pet by ID
# Expected Status: 200
# Expected Properties: id, name, tag
GET {{baseUrl}}/pets/42 HTTP/1.1
Accept: application/json

###
# @name delete_pets_pet_id
# Operation: delete_pets_pet_id
# Description: Delete pet by ID
# Expected Status: 204
DELETE {{baseUrl}}/pets/42 HTTP/1.1
